# Pylint configuration for Teams-Export
# Targets Python 3.10+ (see .github/workflows/pylint.yml).

[MAIN]
# The cache reader is imported lazily and is not installed in CI,
# so tell pylint not to flag it as an import error.
ignored-modules=ccl_chromium_reader,snappy

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
# Disabled on purpose - each reflects an intentional style choice in this project,
# not a defect:
#   missing-function-docstring   small internal/CLI-handler functions
#   import-outside-toplevel      deliberate lazy import of the cache reader
#   broad-exception-caught       best-effort robustness around console I/O
#   unused-argument              argparse handlers share a (args) signature
#   invalid-name                 short loop/record variable names (m, e, p, ...)
#   consider-using-f-string      %-formatting for byte sizes, functionally fine
#   too-many-*                   message parsing is inherently branchy
disable=missing-function-docstring,
        import-outside-toplevel,
        broad-exception-caught,
        unused-argument,
        invalid-name,
        consider-using-f-string,
        too-many-locals,
        too-many-branches,
        too-many-statements,
        too-many-return-statements,
        too-many-arguments,
        too-many-positional-arguments
